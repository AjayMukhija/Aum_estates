<script src="data/public_inventory.js?v=FINAL_20261009"></script><script src="data/dev_inventory.js"></script><script src="data/projects_local.js"></script>
<script>
(function(){
 const data=Array.isArray(window.AUM_PUBLIC_INVENTORY)?window.AUM_PUBLIC_INVENTORY:[];
 const host=document.getElementById('location-inventory-grid'); if(!host)return;
 const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const norm=s=>String(s??'').toLowerCase().replace(/&/g,'and').replace(/[^a-z0-9]+/g,' ').trim();
 const hay=o=>[o.city,o.locality,o.sector,o.micro_location,o.project_name,o.listing_title,o.public_description,o.key_features,o.public_features].filter(Boolean).join(' ');
 const locations=[
  {name:'DLF',sub:'Gurgaon',q:'DLF',match:o=>norm([o.project_name,o.listing_title,o.locality,o.micro_location].filter(Boolean).join(' ')).includes('dlf')},
  {name:'Golf Course Road',sub:'Gurgaon',q:'Golf Course Road',match:o=>{
    const fields=norm([o.locality,o.sector,o.micro_location].filter(Boolean).join(' '));
    const project=norm([o.project_name,o.listing_title].filter(Boolean).join(' '));
    const namedProjects=['dlf bela ire','dlf belaire','dlf park place','dlf magnolias','dlf aralias','dlf camellias','dlf crest','the crest','dlf carlton estate','dlf westend','dlf west end','dlf south point mall'];
    return fields.includes('golf course road')||fields.includes('golf course rd')||namedProjects.some(n=>project.includes(n));
  }},
  {name:'Sohna Road',sub:'Gurgaon',q:'Sohna Road',match:o=>{
    const fields=norm([o.locality,o.sector,o.micro_location].filter(Boolean).join(' '));
    return fields.includes('sohna road')||fields.includes('sohna-road');
  }},
  {name:'Sohna',sub:'Sohna / South Gurgaon',q:'Sohna',match:o=>{
    const fields=norm([o.locality,o.sector,o.micro_location,o.project_name].filter(Boolean).join(' '));
    const isSohnaRoad=fields.includes('sohna road')||fields.includes('sohna-road');
    const isGurgaonLocality=fields.includes('south city')||fields.includes('nirvana country');
    return !isSohnaRoad&&!isGurgaonLocality&&(fields==='sohna'||fields.includes(' imt sohna')||fields.startsWith('imt sohna')||fields.includes('sohna sector'));
  }},
  {name:'Manesar',sub:'Industrial & Plots',q:'Manesar',match:o=>norm([o.locality,o.sector,o.micro_location,o.project_name].filter(Boolean).join(' ')).includes('manesar')},
  {name:'Dwarka Expressway',sub:'Gurgaon & New Growth Corridor',q:'Dwarka Expressway',match:o=>{
    const fields=norm([o.locality,o.sector,o.micro_location,o.project_name,o.listing_title].filter(Boolean).join(' '));
    // DLF NTH Sector 90 is on the Dwarka Expressway; use an explicit project rule.
    return fields.includes('dwarka expressway')||fields.includes('dwarka exp')||fields.includes('dlf nth sector 90');
  }}
 ];
 const cleanName=o=>o.website_display_name||o.listing_title||o.project_name||'Property';
 const locLabel=o=>[o.locality,o.sector,o.city].filter(Boolean).filter((v,i,a)=>a.indexOf(v)===i).join(', ');
 const price=o=>o.price_text || (o.price_value!=null?`₹${o.price_value} ${o.price_unit||''}`.trim():'Price on request');
 locations.forEach(l=>{
   const rows=data.filter(o=>l.match(o));
   const shown=rows.slice(0,4);
   const items=shown.length?shown.map(o=>`<a class="location-item" href="properties/detail.html?id=${encodeURIComponent(o.property_id||'')}" aria-label="View ${esc(cleanName(o))}"><div><strong>${esc(cleanName(o))}</strong><span>${esc(locLabel(o)||l.sub)}</span></div><b>${esc(price(o))}</b></a>`).join(''):`<div class="location-empty">No inventory is currently tagged to this location.</div>`;
   host.insertAdjacentHTML('beforeend',`<article class="location-panel"><div class="location-panel-head"><div><div class="eyebrow">${esc(l.sub)}</div><h3>${esc(l.name)}</h3></div><span class="location-count">${rows.length} ${rows.length===1?'property':'properties'}</span></div><div class="location-items">${items}</div><a class="location-view" href="properties/index.html?q=${encodeURIComponent(l.q)}">View ${esc(l.name)} inventory →</a></article>`);
 });
})();
</script>
<div class="representative-disclaimer"><strong>*RP:</strong> Representative picture. Images are for illustration/reference and may not depict the exact property. Actual property photographs, where available, can be shared on request.</div>
<script src="data/projects_local.js"></script><script src="data/approved_properties.js"></script><script src="data/inventory-search.js"></script><script>
(function(){
 const approved=Array.isArray(window.AUM_APPROVED_PROPERTIES)?window.AUM_APPROVED_PROPERTIES:[];
 const host=document.getElementById('approved-properties-grid');
 if(!host) return;
 const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const money=o=>o.price_text||o.price||'Price on request';
 const card=o=>{
   const img=o.image?`<div class="approved-card-photo photo" style="background-image:url('${esc(o.image)}')"><span class="photo-label">${esc((!o.image_label||/representative|project\/property image/i.test(o.image_label))?'*RP':o.image_label)}</span></div>`:'<div class="approved-card-photo photo"></div>';
   const wa=`https://wa.me/919873813595?text=${encodeURIComponent(['AUM ESTATES – PROPERTY ENQUIRY','',`Property ID: ${o.property_id||'N/A'}`,`Property: ${o.name||'Approved Property'}`,`Location: ${o.location||'N/A'}`,`Property Type: ${o.type||'N/A'}`,`Price: ${o.price_text||'Price on request'}`,'','I am interested in this property. Please share further details and availability.'].join('\n'))}`;
   return `<article class="card">${img}<div class="cardbody"><div class="loc">${esc(o.location||'AUM ESTATES')}</div><h3>${esc(o.name||'Approved Property')}</h3><p>${esc(o.description||'Approved property available through AUM ESTATES.')}</p><p class="price">${esc(money(o))}</p><a class="btn" href="${wa}" target="_blank" rel="noopener">Enquire on WhatsApp</a></div></article>`;
 };
 host.innerHTML=approved.length?approved.slice(0,10).map(card).join(''):`<div class="approved-empty"><div class="loc">PUBLIC APPROVAL</div><h3>Properties will appear here as they are approved</h3><p>This section is now ready for the AUM ESTATES approved-property workflow. No property has been published here without explicit approval.</p><a class="btn" href="https://wa.me/919873813595?text=${encodeURIComponent('Hello AUM ESTATES, I would like to enquire about approved properties.') }" target="_blank" rel="noopener">Enquire on WhatsApp</a></div>`;
})();
</script>
<script>
(function(){
 const d=Array.isArray(window.AUM_PUBLIC_INVENTORY)?window.AUM_PUBLIC_INVENTORY:[];
 const active=d.filter(x=>x&&x.transaction_type);
 const norm=v=>String(v??'').normalize('NFKD').toLowerCase().replace(/[–—]/g,'-').replace(/[^a-z0-9+]+/g,' ').trim(); const cat=x=>{const p=norm(x.property_type||'');if(/\b(plot|plots|land|farm land)\b/.test(p))return'plot';if(/\b(commercial|office|offices|shop|shops|retail|warehouse|industrial|factory)\b/.test(p))return'commercial';if(/\bfarmhouse|farm house\b/.test(p))return'farmhouse';if(p&&!/^(property|other|unknown|residential|real estate)$/.test(p))return'residential';const c=norm(x.configuration||'');if(/\b(plot|plots|land|farm land)\b/.test(c))return'plot';if(/\b(commercial|office|offices|shop|shops|retail|warehouse|industrial|factory)\b/.test(c))return'commercial';if(/\bfarmhouse|farm house\b/.test(c))return'farmhouse';const t=norm([x.listing_title,x.project_name,x.key_features].join(' '));if(/\bfarmhouse|farm house\b/.test(t))return'farmhouse';if(/\b(plot|plots|land|farm land)\b/.test(t))return'plot';if(/\b(commercial|office|offices|shop|shops|retail|warehouse|industrial|factory)\b/.test(t))return'commercial';return'residential';};
 document.querySelectorAll('[data-cat-count]').forEach(e=>e.textContent=active.filter(x=>cat(x)===e.dataset.catCount).length);
 const projects=Array.isArray(window.AUM_PROJECTS_LOCAL)?window.AUM_PROJECTS_LOCAL:[]; const e=document.querySelector('[data-project-count]'); if(e)e.textContent=projects.filter(x=>x&&x.project_category==='New Project').length;
})();
</script></body></html>
