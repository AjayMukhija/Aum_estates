# Dependencies & OS artifacts
node_modules/
.DS_Store
*.log

# Environment & Secrets
.env
.env.*

# Confidential Master SQLite CRM Vault, Sessions & Release Snapshots
private_master_store/db/
private_master_store/releases/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Local Backups & Temp files
**/backups/
*.bak
*.backup
*.tmp.*

# Release staging and local credential exports
.dist_hostinger.*
dist_hostinger_php/
admin-credentials.json
backend_php/db/*.sql
!backend_php/db/schema.mariadb.sql
backend_php/logs/

# Raw confidential seed files must never enter public Git history again
/private_master_store/*.json

# Deployment upload archives (rebuilt by npm run package:php)
*_upload.zip

# Carries the production SSH host, user and port as defaults. Held out of Git
# while this repository is PUBLIC, so that a `git add -A` cannot publish the
# server's endpoint. Once the repository is private this line can be removed
# and the script committed — or better, drop the hardcoded defaults and let it
# read AUM_SSH_HOST / AUM_SSH_USER / AUM_SSH_PORT / AUM_SSH_KEY from the
# environment, which is safe either way.
scripts/deploy_hostinger.sh
